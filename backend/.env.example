# 复制本文件为 .env 后填写真实值（.env 不要提交到 Git）
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows)

# -----------------------------------------------------------------------------
# 服务
# -----------------------------------------------------------------------------
PORT=3000

# 若本机开了 Clash 等代理但未启动，可能导致有道 API 请求失败。
# 可在启动后端前取消代理，例如 PowerShell：
#   Remove-Item Env:HTTP_PROXY, Env:HTTPS_PROXY -ErrorAction SilentlyContinue

# -----------------------------------------------------------------------------
# 数据库（Prisma / PostgreSQL + pgvector）
# docker-compose 默认：
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/knowledge_base?schema=public"

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# 第三方凭据加密（有道 Cookie 等存库前 AES 加密）
# 自行生成随机串，不要用下面的示例值上线！
#
# PowerShell 生成示例：
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | % { [char]$_ })
#
# Node 生成示例：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=请替换为至少16位随机字符串_示例a7f3c9e2b1d84f6a0e5c8b2d9f1a4e7

# -----------------------------------------------------------------------------
# 有道 / 第三方源定时同步（BullMQ + Redis，仿 OpenClaw Cron 引擎）
# 任务定义：PostgreSQL SyncJob + 本地 data/sync-cron-jobs.json
# 调度执行：BullMQ repeatable job（cron 表达式）+ Worker 消费
# -----------------------------------------------------------------------------
SYNC_CRON_ENABLED=true
SYNC_CRON_STORE=data/sync-cron-jobs.json
SYNC_CRON_TIMEZONE=Asia/Shanghai
SYNC_CRON_CONCURRENCY=1
SYNC_CRON_STARTUP_DELAY_MS=30000
SYNC_CRON_RUN_ON_STARTUP=true

# -----------------------------------------------------------------------------
# LangSmith（LLM / RAG 链路追踪，https://smith.langchain.com/）
# 启用后可在 LangSmith 查看：检索 knowledge-hybrid-search + 对话 streamText
# -----------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_your-langsmith-api-key
LANGSMITH_PROJECT=knowledge-base
# 兼容旧变量名（任选其一，代码会同步）
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=knowledge-base
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# -----------------------------------------------------------------------------
# 阿里云 DashScope（对话 + 向量嵌入）
# https://dashscope.console.aliyun.com/
# -----------------------------------------------------------------------------
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# -----------------------------------------------------------------------------
# 对话性能（RAG 检索约 0.x s，主要耗时在 LLM 生成）
# CHAT_MODEL: qwen-turbo（快）| qwen-plus（质量更好但更慢）
# -----------------------------------------------------------------------------
CHAT_MODEL=qwen-turbo
CHAT_RAG_TOP_K=5
CHAT_RAG_CHUNK_MAX_CHARS=500
CHAT_MAX_OUTPUT_TOKENS=1024
CHAT_MAX_HISTORY_MESSAGES=10
# CHAT_SKIP_RERANK=true

# -----------------------------------------------------------------------------
# JWT（登录注册，可选）
# -----------------------------------------------------------------------------
JWT_SECRET=your-jwt-secret-change-in-production

# -----------------------------------------------------------------------------
# 腾讯云语音（ASR/TTS，可选）
# -----------------------------------------------------------------------------
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# -----------------------------------------------------------------------------
# 有道云笔记官方 OpenAPI（可选，当前同步主要用前端 Cookie 方式）
# https://note.youdao.com/open/developguide.html
# -----------------------------------------------------------------------------
# YOUDAO_CLIENT_ID=
# YOUDAO_CLIENT_SECRET=
# YOUDAO_REDIRECT_URI=http://localhost:3000/sources/youdao/callback

# -----------------------------------------------------------------------------
# Elasticsearch（混合检索 BM25，本地 Docker: docker compose up -d elasticsearch）
# -----------------------------------------------------------------------------
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=knowledge_chunks
SEARCH_ES_ENABLED=true
SEARCH_K_BM25=30
SEARCH_K_VECTOR=30
SEARCH_RRF_K=60
SEARCH_RRF_TOP_N=20
SEARCH_RERANK_TOP_M=8
SEARCH_MIN_RERANK_SCORE=0.2
DASHSCOPE_RERANK_MODEL=gte-rerank

# -----------------------------------------------------------------------------
# 飞书开放平台（预留，接入飞书文档时使用）
# https://open.feishu.cn/
# -----------------------------------------------------------------------------
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_REDIRECT_URI=http://localhost:3000/sources/feishu/callback
