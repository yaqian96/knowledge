generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  conversations   Conversation[]
  documents       KnowledgeDocument[]
  babyTripTasks   BabyTripTask[]
  spots           Spot[]
  sourceAccounts  SourceAccount[]
  syncJobs        SyncJob[]
  
  @@index([email])
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  
  @@index([userId])
  @@index([updatedAt])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime @default(now())
  
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  @@index([conversationId])
  @@index([createdAt])
}

model KnowledgeDocument {
  id             String   @id @default(uuid())
  userId         String
  filename       String
  fileType       String
  filePath       String   @default("")
  content        String?
  chunks         Json?
  sourceProvider String   @default("upload")
  externalId     String?
  externalUrl    String?
  contentHash    String?
  syncedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  vectors  DocumentVector[]
  
  @@index([userId])
  @@index([fileType])
  @@index([sourceProvider])
  @@index([userId, sourceProvider, externalId])
}

model DocumentVector {
  id          String   @id @default(uuid())
  documentId  String
  chunkIndex  Int
  content     String
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime @default(now())
  
  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  @@index([documentId])
}

// Baby Trip Task
model BabyTripTask {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  status      String   @default("pending")
  spotIds     Json?
  
  traceId     String?
  trace       BabyTripTrace?
  
  emailSent   Boolean  @default(false)
  emailSentAt DateTime?
  
  createdAt   DateTime @default(now())
  completedAt DateTime?
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// Execution Trace Record
model BabyTripTrace {
  id            String   @id @default(uuid())
  taskId        String   @unique
  userId        String
  
  reasoningSteps Json
  toolCalls      Json
  
  finalOutput    String?
  
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  totalDuration  Int?
  tokenUsage     Json?
  
  task           BabyTripTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([startedAt])
}

// Visited Spots
model Spot {
  id          String   @id @default(uuid())
  userId      String
  name        String
  address     String
  latitude    Float
  longitude   Float
  distance    Float?
  category    String
  ageRange    String?
  ticketPrice String?
  parkingFee  String?
  transport   String?
  description String?
  rating      Float?
  images      Json?
  visitedAt   DateTime?
  experience  String?
  weather     Json?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([category])
  @@index([visitedAt])
}

// Email Log
model EmailLog {
  id          String   @id @default(uuid())
  userId      String
  taskId      String?
  to          String
  subject     String
  content     String
  status      String   @default("pending")
  errorMsg    String?
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// Source Connector Tables
model SourceAccount {
  id              String   @id @default(uuid())
  userId          String
  provider        String
  authMethod      String
  encryptedPayload String
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, provider, authMethod])
  @@index([userId])
}

model SyncJob {
  id        String   @id @default(uuid())
  userId    String
  provider  String
  enabled   Boolean  @default(true)
  cronExpr  String   @default("0 */1 * * *")
  lastSyncAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  targets   SyncTarget[]
  runs      SyncRun[]
  
  @@unique([userId, provider])
  @@index([userId])
}

model SyncTarget {
  id         String   @id @default(uuid())
  syncJobId  String
  externalId String
  title      String
  parentId   String?
  syncStatus String   @default("pending")
  lastError  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  syncJob    SyncJob    @relation(fields: [syncJobId], references: [id], onDelete: Cascade)
  
  @@unique([syncJobId, externalId])
  @@index([syncJobId])
}

model SyncRun {
  id         String   @id @default(uuid())
  syncJobId  String
  status     String
  total      Int      @default(0)
  succeeded  Int      @default(0)
  failed     Int      @default(0)
  message    String?
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  
  syncJob    SyncJob    @relation(fields: [syncJobId], references: [id], onDelete: Cascade)
  
  @@index([syncJobId])
}
